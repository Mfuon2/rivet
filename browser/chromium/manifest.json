{
  "manifest_version": 3,
  "name": "Rivet \u2014 Download Manager",
  "version": "0.1.0",
  "description": "Send links to your local Rivet queue. Media discovery requires explicit site permission.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "storage",
    "webRequest"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rivet downloads",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
