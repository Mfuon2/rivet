{
  "manifest_version": 2,
  "name": "Rivet — Download Manager",
  "version": "0.1.0",
  "description": "Send links to your local Rivet queue. Media discovery requires explicit site permission.",
  "permissions": ["contextMenus", "nativeMessaging", "activeTab", "storage", "webRequest"],
  "optional_permissions": ["http://*/*", "https://*/*"],
  "background": {"scripts": ["background.js"]},
  "browser_action": {"default_popup": "popup.html", "default_title": "Rivet downloads"},
  "browser_specific_settings": {"gecko": {"id": "rivet@rivet.local", "strict_min_version": "115.0"}}
}
